<?xml version='1.0' encoding='utf-8'?>
<CompanionHudAddon schemaVersion="1">
  <Resources>
    <Bitmap id="yt_hud_settings_no" file="companion-hud/settings_no.png" alphacolor="#FF00FF" />
    <Bitmap id="yt_hud_settings_hov" file="companion-hud/settings_hov.png" alphacolor="#FF00FF" />
    <Bitmap id="yt_hud_settings_do" file="companion-hud/settings_do.png" alphacolor="#FF00FF" />
    <Bitmap id="yt_hud_cc_off_no" file="companion-hud/cc_off_no.png" alphacolor="#FF00FF" />
    <Bitmap id="yt_hud_cc_off_hov" file="companion-hud/cc_off_hov.png" alphacolor="#FF00FF" />
    <Bitmap id="yt_hud_cc_off_do" file="companion-hud/cc_off_do.png" alphacolor="#FF00FF" />
    <Bitmap id="yt_hud_cc_on_no" file="companion-hud/cc_on_no.png" alphacolor="#FF00FF" />
    <Bitmap id="yt_hud_cc_on_hov" file="companion-hud/cc_on_hov.png" alphacolor="#FF00FF" />
    <Bitmap id="yt_hud_cc_on_do" file="companion-hud/cc_on_do.png" alphacolor="#FF00FF" />
    <Bitmap id="yt_hud_command_hit" file="companion-hud/command_hit.png" alphacolor="#FF00FF" />
  </Resources>
  <Controllers>
    <Controller layout="fullscreen_controls">
      <Button id="yt_fullscreen_settings" x="300" y="0" up="yt_hud_settings_no" over="yt_hud_settings_hov" down="yt_hud_settings_do" action="yt_playback_actions.setLayout(yt_playback_settings)" tooltiptext="Playback settings" visible="fullscreenController.isVisible and yt_controls_available.isActive" />
      <Checkbox id="yt_fullscreen_cc" x="330" y="0" state="yt_cc_on.isActive" action1="yt_playback_actions.setLayout(yt_playback_cc)" action2="yt_playback_actions.setLayout(yt_playback_cc)" tooltiptext1="Turn captions on" tooltiptext2="Turn captions off" visible="fullscreenController.isVisible and yt_controls_available.isActive" up1="yt_hud_cc_off_no" over1="yt_hud_cc_off_hov" down1="yt_hud_cc_off_do" up2="yt_hud_cc_on_no" over2="yt_hud_cc_on_hov" down2="yt_hud_cc_on_do" />
    </Controller>
    <Controller layout="video_hover_controls">
      <Button id="yt_hover_settings" x="300" y="0" up="yt_hud_settings_no" over="yt_hud_settings_hov" down="yt_hud_settings_do" action="yt_playback_actions.setLayout(yt_playback_settings)" tooltiptext="Playback settings" visible="video_hover_controls.isActive and yt_controls_available.isActive" />
      <Checkbox id="yt_hover_cc" x="330" y="0" state="yt_cc_on.isActive" action1="yt_playback_actions.setLayout(yt_playback_cc)" action2="yt_playback_actions.setLayout(yt_playback_cc)" tooltiptext1="Turn captions on" tooltiptext2="Turn captions off" visible="video_hover_controls.isActive and yt_controls_available.isActive" up1="yt_hud_cc_off_no" over1="yt_hud_cc_off_hov" down1="yt_hud_cc_off_do" up2="yt_hud_cc_on_no" over2="yt_hud_cc_on_hov" down2="yt_hud_cc_on_do" />
    </Controller>
  </Controllers>
  <Windows>
    <Window id="yt_playback_actions" x="-31000" y="-30600" visible="true" dragdrop="false" playondrop="false">
      <Layout id="yt_playback_settings" width="212" height="17">
        <Image id="yt_settings_reset_cell" image="yt_hud_command_hit" x="0" y="0" width="3" height="3" resize="scale" action2="yt_playback_actions.setLayout(yt_playback_ready)" />
        <Image id="yt_settings_cc_on_cell" image="yt_hud_command_hit" x="10" y="0" width="3" height="3" resize="scale" action2="yt_cc_indicator.setLayout(yt_cc_on)" />
        <Image id="yt_settings_cc_off_cell" image="yt_hud_command_hit" x="20" y="0" width="3" height="3" resize="scale" action2="yt_cc_indicator.setLayout(yt_cc_off)" />
        <Image id="yt_settings_available_cell" image="yt_hud_command_hit" x="30" y="0" width="3" height="3" resize="scale" action2="yt_hud_availability.setLayout(yt_controls_available)" />
        <Image id="yt_settings_unavailable_cell" image="yt_hud_command_hit" x="40" y="0" width="3" height="3" resize="scale" action2="yt_hud_availability.setLayout(yt_controls_unavailable)" />
      </Layout>
      <Layout id="yt_playback_cc" width="213" height="17">
        <Image id="yt_cc_reset_cell" image="yt_hud_command_hit" x="0" y="0" width="3" height="3" resize="scale" action2="yt_playback_actions.setLayout(yt_playback_ready)" />
        <Image id="yt_cc_cc_on_cell" image="yt_hud_command_hit" x="10" y="0" width="3" height="3" resize="scale" action2="yt_cc_indicator.setLayout(yt_cc_on)" />
        <Image id="yt_cc_cc_off_cell" image="yt_hud_command_hit" x="20" y="0" width="3" height="3" resize="scale" action2="yt_cc_indicator.setLayout(yt_cc_off)" />
        <Image id="yt_cc_available_cell" image="yt_hud_command_hit" x="30" y="0" width="3" height="3" resize="scale" action2="yt_hud_availability.setLayout(yt_controls_available)" />
        <Image id="yt_cc_unavailable_cell" image="yt_hud_command_hit" x="40" y="0" width="3" height="3" resize="scale" action2="yt_hud_availability.setLayout(yt_controls_unavailable)" />
      </Layout>
      <Layout id="yt_playback_ready" width="211" height="17">
        <Image id="yt_ready_reset_cell" image="yt_hud_command_hit" x="0" y="0" width="3" height="3" resize="scale" action2="yt_playback_actions.setLayout(yt_playback_ready)" />
        <Image id="yt_ready_cc_on_cell" image="yt_hud_command_hit" x="10" y="0" width="3" height="3" resize="scale" action2="yt_cc_indicator.setLayout(yt_cc_on)" />
        <Image id="yt_ready_cc_off_cell" image="yt_hud_command_hit" x="20" y="0" width="3" height="3" resize="scale" action2="yt_cc_indicator.setLayout(yt_cc_off)" />
        <Image id="yt_ready_available_cell" image="yt_hud_command_hit" x="30" y="0" width="3" height="3" resize="scale" action2="yt_hud_availability.setLayout(yt_controls_available)" />
        <Image id="yt_ready_unavailable_cell" image="yt_hud_command_hit" x="40" y="0" width="3" height="3" resize="scale" action2="yt_hud_availability.setLayout(yt_controls_unavailable)" />
      </Layout>
    </Window>
    <Window id="yt_cc_indicator" x="-31000" y="-30500" visible="false" dragdrop="false" playondrop="false">
      <Layout id="yt_cc_on" width="222" height="1">
        <Image id="yt_cc_on_marker" image="yt_hud_command_hit" x="0" y="0" width="1" height="1" resize="scale" />
      </Layout>
      <Layout id="yt_cc_off" width="221" height="1">
        <Image id="yt_cc_off_marker" image="yt_hud_command_hit" x="0" y="0" width="1" height="1" resize="scale" />
      </Layout>
    </Window>
    <Window id="yt_hud_availability" x="-31000" y="-30400" visible="false" dragdrop="false" playondrop="false">
      <Layout id="yt_controls_available" width="223" height="1">
        <Image id="yt_controls_available_marker" image="yt_hud_command_hit" x="0" y="0" width="1" height="1" resize="scale" />
      </Layout>
      <Layout id="yt_controls_unavailable" width="224" height="1">
        <Image id="yt_controls_unavailable_marker" image="yt_hud_command_hit" x="0" y="0" width="1" height="1" resize="scale" />
      </Layout>
    </Window>
  </Windows>
</CompanionHudAddon>
